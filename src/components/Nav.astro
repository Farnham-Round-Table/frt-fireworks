---
import { getEntry } from 'astro:content';
import { sectionOrder } from '../lib/sections';

const items = (await Promise.all(sectionOrder.map((id) => getEntry('sections', id)))).filter((s) => s?.data.inNav);
---

<nav class="navbar is-fixed-top is-warning" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    <a class="navbar-item" href="/">
      <img src="/img/frt-logo-horiz.png" alt="Farnham Round Table logo" />
    </a>
    <a id="navbar-burger" role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasicExample">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div id="navbarBasicExample" class="navbar-menu">
    <div class="navbar-start">
      {
        items.map((s) => (
          <a class="navbar-item menu-item" href={`#${s!.id}`}>
            <span class="icon-text">
              <span class="icon">
                <i class={s!.data.icon} />
              </span>
              <span>{s!.data.title}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="navbar-end">
      <div class="navbar-item">
        <div class="buttons">
          <a class="button is-black" href="#tickets">
            <strong>Buy Tickets</strong>
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
