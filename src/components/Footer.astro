---
import { loadSingle } from '../lib/sections';
const { footer, googleAnalyticsId } = await loadSingle('site', 'site');
---

<footer class="footer">
  <div class="container">
    <div class="level">
      <p class="level-item"><a href={footer.roundTableUrl}>&copy; Farnham Round Table</a></p>
      <p class="level-item">
        <a class="social-icon-link" href={footer.facebookUrl} target="_blank" rel="noopener" aria-label="Farnham Round Table on Facebook">
          <span class="icon is-large">
            <i class="fa-brands fa-facebook"></i>
          </span>
        </a>
        <a class="social-icon-link" href={footer.instagramUrl} target="_blank" rel="noopener" aria-label="Farnham Round Table on Instagram">
          <span class="icon is-large">
            <i class="fa-brands fa-square-instagram"></i>
          </span>
        </a>
      </p>
    </div>
    {googleAnalyticsId !== 'G-XXXXXXXXXX' && (
      <p class="has-text-centered is-size-7"><a href="#cookie-settings" id="cookie-settings-link">Cookie settings</a></p>
    )}
  </div>
</footer>
