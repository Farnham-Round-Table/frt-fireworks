---
import { loadSection } from '../lib/sections';
import SectionHeading from './SectionHeading.astro';

const s = await loadSection('video');
if (!s.youtubeId) throw new Error('src/content/sections/video.md needs a youtubeId');
---

<section id="video" class="section">
  <div class="container">
    <SectionHeading icon={s.icon} title={s.title} />
    <s.Content />
    <figure class="image is-16by9 video-facade" data-video-id={s.youtubeId}>
      <button type="button" class="video-play" aria-label="Play video">
        <img src={`https://i.ytimg.com/vi/${s.youtubeId}/maxresdefault.jpg`} alt="" loading="lazy" width="1280" height="720" />
        <span class="video-play-icon" aria-hidden="true"></span>
      </button>
      <noscript>
        <a href={`https://www.youtube.com/watch?v=${s.youtubeId}`}>Watch the video on YouTube</a>
      </noscript>
    </figure>
  </div>
</section>
