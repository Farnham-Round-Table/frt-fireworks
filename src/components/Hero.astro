---
import { loadSingle } from '../lib/sections';
const site = await loadSingle('site', 'site');

const d = site.eventDate;
const day = d.getUTCDate();
const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
const weekday = d.toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
const month = d.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });
---

<section class="hero is-fullheight-with-navbar hero-image">
  <div class="hero-body">
    <div class="container has-text-centered">
      <h1 class="title is-2 has-text-white">{site.title}</h1>
      <h2 class="subtitle is-4 has-text-white">{weekday} {day}<sup>{suffix}</sup> {month} {d.getUTCFullYear()}</h2>
      <a href="#tickets"><button class="button is-warning is-large">Buy Tickets</button></a>
    </div>
  </div>
</section>
